# Copy to .env next to docker-compose.yml. Lines you leave blank keep their defaults.

# Shown in the portal and on the dashboard. Defaults to the container's host name.
EDGE_NAME=Site edge

# Which cloud this edge relays to: test.proav.cloud (develop) or proav.cloud (main).
EDGE_CLOUD_HOST=test.proav.cloud
EDGE_CLOUD_SECURE=true

# Namespace API key with the device-register capability (Portal → Settings → API keys). Only needed for the
# edge's FIRST registration: after that the edge keeps its own device key in the edge-data volume. Processors it
# enrols are registered with that device key too, once "May enrol processors" is switched on for this edge in the
# portal (edge page, Enrolment section). Then remove the key here and run `docker compose up -d`; the dashboard's
# Processors tab says when it is safe. (An older cloud without edge enrolment still needs it for processors.)
EDGE_CLOUD_API_KEY=

# What to do when a processor with no apiKey of its own asks to register: Pairing (approve each one on the
# dashboard; default), Open (register everyone that asks), or Off.
EDGE_ENROLMENT_MODE=Pairing

# Corporate proxy between the site and the internet. Mode: None | System | Manual
#   None    connect straight out
#   System  use HTTPS_PROXY / HTTP_PROXY / NO_PROXY below
#   Manual  use EDGE_PROXY_URL with optional basic-auth credentials
EDGE_PROXY_MODE=None
EDGE_PROXY_URL=
EDGE_PROXY_USERNAME=
EDGE_PROXY_PASSWORD=
# One host, or a suffix starting with a dot, that must bypass the proxy (optional).
EDGE_PROXY_BYPASS=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# HTTPS relay port for processors that use cloudConfig.secure = true. With no PFX below, the edge generates
# a self-signed certificate on first start and keeps it in the edge-data volume; processors pin its fingerprint
# (shown on the dashboard and printed by the installer). Set to 0 to relay over plain HTTP on 8080 only.
EDGE_RELAY_HTTPS_PORT=8443
# Optional: your own certificate (a PFX that chains to a root the processors trust) instead of the generated one.
EDGE_RELAY_CERT_PATH=
EDGE_RELAY_CERT_PASSWORD=

# Advertise this edge on the local network by mDNS (_proav-edge._tcp), so processors configured with
# cloudConfig.host = "auto" find it. Needs the host networking the compose file uses.
EDGE_DISCOVERY=true

# Network discovery for the portal's Network tab: listens for mDNS/DNS-SD (Dante, AirPlay …), SSDP and Q-SYS QDP on
# this edge's VLAN (and asks every 15 minutes), and sweeps only the subnets you allow in the portal. Needs the host
# networking the compose file uses. false switches all of it off here, whatever the portal says.
EDGE_NETWORK_DISCOVERY=true

# Package cache: software packages and firmware deployed from the portal are kept on the edge (in edge-data), so
# a deploy to a whole site crosses the uplink once. Every download is still authorised by the cloud with the
# processor's own key. Size cap in GB (least recently used files go first); EDGE_CACHE=false relays them instead.
EDGE_CACHE=true
EDGE_CACHE_MAX_GB=10

# Outbox: processor check-ins the edge cannot deliver during an uplink outage are held on the data volume and
# replayed to the cloud when it is back. Size cap in MB and age cap in hours (oldest dropped first);
# EDGE_OUTBOX=false lets them fail as they would without an edge.
EDGE_OUTBOX=true
EDGE_OUTBOX_MAX_MB=256
EDGE_OUTBOX_MAX_AGE_HOURS=72

# MQTT broker for devices on site (Shelly Gen2+). It listens on the host's TCP port below: open that on the host
# firewall for the devices' network (VLAN) only, never to the internet. Devices sign in as "devices" with a password
# the edge generates (set a new one from the portal). EDGE_MQTT_ENABLED=false switches the broker off.
EDGE_MQTT_ENABLED=true
EDGE_MQTT_PORT=1883

# Ports. The edge runs on the host's network, so these are the ports it listens on directly (no remapping):
# HTTP relay, and the dashboard. The HTTPS relay port is EDGE_RELAY_HTTPS_PORT above.
#EDGE_RELAY_PORT=8080
#EDGE_ADMIN_PORT_PUBLISH=8090

# Dashboard login (http://<edge>:8090/edge/).
EDGE_ADMIN_USERNAME=admin
EDGE_ADMIN_PASSWORD=

# Image tag. The installer pins the release it installed (e.g. 2026.10.15.123) so `docker compose up -d` is
# deterministic; the dashboard updates from there. `latest` (stable) and `next` (beta) are the moving channels.
EDGE_TAG=latest

# Self-update from the dashboard. Channel decides which newer version is recommended: next (beta) or latest
# (stable). Signature verification should stay on; it is what stops a tampered public image being installed.
EDGE_UPDATES_CHANNEL=next
EDGE_UPDATES_VERIFY=true
