# Copy to .env next to docker-compose.yml. Lines you leave blank keep their defaults.

# Shown in the portal and on the dashboard. Defaults to the container's host name.
EDGE_NAME=Site edge

# Which cloud this edge relays to: test.proav.cloud (develop) or proav.cloud (main).
EDGE_CLOUD_HOST=test.proav.cloud
EDGE_CLOUD_SECURE=true

# Namespace API key with the device-register capability (Portal → Settings → API keys). Used once: after the
# edge has been claimed it keeps its own device key in the edge-data volume and this can be removed.
EDGE_CLOUD_API_KEY=

# What to do when a processor with no apiKey of its own asks to register: Pairing (approve each one on the
# dashboard; default), Open (register everyone that asks), or Off. Needs EDGE_CLOUD_API_KEY above.
EDGE_ENROLMENT_MODE=Pairing

# Corporate proxy between the site and the internet. Mode: None | System | Manual
#   None    connect straight out
#   System  use HTTPS_PROXY / HTTP_PROXY / NO_PROXY below
#   Manual  use EDGE_PROXY_URL with optional basic-auth credentials
EDGE_PROXY_MODE=None
EDGE_PROXY_URL=
EDGE_PROXY_USERNAME=
EDGE_PROXY_PASSWORD=
# One host, or a suffix starting with a dot, that must bypass the proxy (optional).
EDGE_PROXY_BYPASS=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# HTTPS relay port for processors that use cloudConfig.secure = true. With no PFX below, the edge generates
# a self-signed certificate on first start and keeps it in the edge-data volume; processors pin its fingerprint
# (shown on the dashboard and printed by the installer). Set to 0 to relay over plain HTTP on 8080 only.
EDGE_RELAY_HTTPS_PORT=8443
# Optional: your own certificate (a PFX that chains to a root the processors trust) instead of the generated one.
EDGE_RELAY_CERT_PATH=
EDGE_RELAY_CERT_PASSWORD=

# Dashboard login (http://<edge>:8090/edge/).
EDGE_ADMIN_USERNAME=admin
EDGE_ADMIN_PASSWORD=

# Image tag. The installer pins the release it installed (e.g. 2026.10.15.123) so `docker compose up -d` is
# deterministic; the dashboard updates from there. `latest` (stable) and `next` (beta) are the moving channels.
EDGE_TAG=latest

# Self-update from the dashboard. Channel decides which newer version is recommended: next (beta) or latest
# (stable). Signature verification should stay on; it is what stops a tampered public image being installed.
EDGE_UPDATES_CHANNEL=next
EDGE_UPDATES_VERIFY=true
